{
    "controlType": "SECTION_V2",
    "identifier": "NOTIFICATION_SETTINGS",
    "conditionals": {
        "show": "{{actionConfiguration.formData.endpoint.data === 'send_notification'}}"
    },
    "children": [
        {
            "controlType": "DOUBLE_COLUMN_ZONE",
            "identifier": "NOTIFICATION_SETTINGS-Z1",
            "children": [
                {
                    "label": "알림 유형",
                    "propertyName": "notificationType",
                    "controlType": "DROP_DOWN",
                    "initialValue": "LEAD_REGISTRATION",
                    "options": [
                        {
                            "label": "리드 등록 알림",
                            "value": "LEAD_REGISTRATION"
                        },
                        {
                            "label": "리드 담당자 배정 알림",
                            "value": "LEAD_ASSIGNMENT"
                        },
                        {
                            "label": "리드 상태 변경 알림",
                            "value": "LEAD_STATUS_UPDATE"
                        }
                    ],
                    "configProperty": "actionConfiguration.formData.notificationType.data",
                    "isRequired": true
                },
                {
                    "label": "Company UUID",
                    "propertyName": "companyUuid",
                    "controlType": "INPUT_TEXT",
                    "configProperty": "actionConfiguration.formData.companyUuid.data",
                    "isRequired": true
                }
            ]
        },
        {
            "controlType": "SINGLE_COLUMN_ZONE",
            "identifier": "NOTIFICATION_SETTINGS-Z2",
            "children": [
                {
                    "label": "알림 메시지",
                    "propertyName": "message_registration",
                    "controlType": "INPUT_TEXT",
                    "inputType": "TEXT_MULTI_LINE",
                    "configProperty": "actionConfiguration.formData.message_registration.data",
                    "initialValue": "[리드 등록] 리드가 등록되었습니다.",
                    "conditionals": {
                        "show": "{{actionConfiguration.formData.notificationType.data === 'LEAD_REGISTRATION'}}"
                    },
                    "isRequired": true
                },
                {
                    "label": "알림 메시지",
                    "propertyName": "message_assignment",
                    "controlType": "INPUT_TEXT",
                    "inputType": "TEXT_MULTI_LINE",
                    "configProperty": "actionConfiguration.formData.message_assignment.data",
                    "initialValue": "[리드 담당자 배정] 리드 담당자로 배정되었습니다.",
                    "conditionals": {
                        "show": "{{actionConfiguration.formData.notificationType.data === 'LEAD_ASSIGNMENT'}}"
                    },
                    "isRequired": true
                },
                {
                    "label": "알림 메시지",
                    "propertyName": "message_status_update",
                    "controlType": "INPUT_TEXT",
                    "inputType": "TEXT_MULTI_LINE",
                    "configProperty": "actionConfiguration.formData.message_status_update.data",
                    "initialValue": "[리드 상태 변경] 리드 상태가 변경되었습니다.",
                    "conditionals": {
                        "show": "{{actionConfiguration.formData.notificationType.data === 'LEAD_STATUS_UPDATE'}}"
                    },
                    "isRequired": true
                },
                {
                    "label": "수신자 ID (Platform User IDs)",
                    "propertyName": "platformUserIds",
                    "controlType": "INPUT_TEXT",
                    "configProperty": "actionConfiguration.formData.platformUserIds.data",
                    "initialValue": "{{this.params.userTo}}",
                    "isRequired": true
                }
            ]
        }
    ]
}